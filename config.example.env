# ── Quote/0 开放平台（Dot. App → More → API Key 创建；设备序列号见设备设置）──
export QUOTE0_API_KEY="dot_app_xxx"
export QUOTE0_DEVICE_ID="YOUR_DEVICE_ID"

# 可选：设备上有多个 Image API 卡片时，指定要更新哪一张（--list-tasks 查 key）
export QUOTE0_IMAGE_TASK_KEY=""
export QUOTE0_TEXT_TASK_KEY=""

# 推送后是否立即刷新屏幕（loop 卡片有效）／是否顺带 /next 切换显示
export QUOTE0_REFRESH_NOW="true"
export QUOTE0_SWITCH_NEXT="true"

# ── GLM（智谱开放平台 https://open.bigmodel.cn 的 API Key）──
export GLM_API_KEY="xxxxxx.xxxxxx"
# 套餐端点：cn=国内个人版（默认）| intl=国际版 z.ai | team=团队版
export GLM_PLAN="cn"
# 团队版需要（个人版留空）：控制台用量页网络请求里可找到这两个值
export GLM_ORG=""
export GLM_PROJECT=""

# 预览图输出路径（--preview）
export QUOTE0_PREVIEW_PATH="tmp/preview.png"

# 自调度循环间隔（可选，如 60 / 5m / 1h，最低 60s；被 --interval 覆盖）
# export REFRESH_INTERVAL="5m"
